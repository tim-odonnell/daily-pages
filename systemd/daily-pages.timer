[Unit]
Description=Publish timodonnell.info/daily every day at 03:00 (after economy 02:05; gold/VFINX/VBMFX 02:10-02:14 Tue-Sat); 06:50 re-run catches a late economy report

[Timer]
OnCalendar=*-*-* 03:00:00
# second run: picks up the 06:40 backup economy report if the 02:05 build failed (pushes only when the page changed)
OnCalendar=*-*-* 06:50:00
# a run missed while the laptop was off is made at the next boot (each report shows its own date)
Persistent=true

[Install]
WantedBy=timers.target
