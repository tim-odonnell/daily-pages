[Unit]
Description=Publish the combined daily reports page (economy, VFINX, VBMFX, gold) to timodonnell.info/daily
Wants=network-online.target
After=network-online.target gold-report.service vfinx-report.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/daily-pages --notify
TimeoutStartSec=5min
Nice=10
